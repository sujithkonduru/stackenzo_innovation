# The frontend calls this path directly from the browser. Leave this as the
# relative "/api" (the default) to route requests through the Vite dev-server
# proxy configured in vite.config.js — this avoids CORS errors, since the
# backend does not send CORS headers.
VITE_API_BASE_URL=/api

# The real backend the proxy forwards "/api/*" requests to. This value is
# only read by vite.config.js on the server side (inside Node) — it is never
# sent to the browser, so it's safe to point at any host/port.
VITE_BACKEND_ORIGIN=http://localhost:8000
